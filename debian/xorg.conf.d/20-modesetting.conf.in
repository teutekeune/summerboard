# Generated by setup.sh — modesetting + glamor + DRI3 (Debian Mesa).
# Placeholders: @BUSID@  @KMSDEV@

Section "Device"
    Identifier "gpu"
    Driver "modesetting"
    BusID "@BUSID@"
    Option "kmsdev" "@KMSDEV@"
    Option "AccelMethod" "glamor"
    Option "DRI" "3"
EndSection

Section "Monitor"
    Identifier "panel"
EndSection

Section "Screen"
    Identifier "screen"
    Device "gpu"
    Monitor "panel"
    DefaultDepth 24
EndSection
